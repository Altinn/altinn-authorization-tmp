meta {
  name: POST_v2_Delegate_Resource
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/clientdelegations/agents/resources?party={{party}}&client={{client}}&agent={{agent}}
  body: json
  auth: inherit
}

params:query {
  party: {{party}}
  client: {{client}}
  agent: {{agent}}
}

body:json {
  {
    "values": [
      {
        "role": "rettighetshaver",
        "resources": [
          "{{resourceRefId}}"
        ]
      }
    ]
  }
}

script:pre-request {
  const sharedtestdata = require(`./testdata/sharedtestdata.js`);
  const testdata = require(`./testdata/klient-delegation/${bru.getEnvVar("tokenEnv")}.js`);
  const enduser = require(`./testdata/enduser/${bru.getEnvVar("tokenEnv")}.js`);

  bru.setVar("party", enduser.org2_delegates_tilgangspakke.partyuuid);
  bru.setVar("client", enduser.org1_delegates_tilgangspakke.partyuuid);
  bru.setVar("agent", testdata.REGN_Organisasjon.REGN_Agent.userUuid);

  // Delegation input takes the resource registry id (RefId), not the internal guid.
  bru.setVar("resourceRefId", testdata.resources.clientDelgResourceId);

  var getTokenParameters = {
    auth_userId: enduser.org2_delegates_tilgangspakke.innehaver.userid,
    auth_partyId: enduser.org2_delegates_tilgangspakke.innehaver.partyid,
    auth_partyUuid: enduser.org2_delegates_tilgangspakke.innehaver.partyuuid,
    auth_ssn: enduser.org2_delegates_tilgangspakke.innehaver.pid,
    auth_tokenType: sharedtestdata.authTokenType.personal,
    auth_scopes: sharedtestdata.auth_scopes.portalEnduser
  }

  const testTokenGenerator = require(`./TestToolsTokenGenerator.js`);
  const token = await testTokenGenerator.getToken(getTokenParameters);
  bru.setVar("bearerToken",  token);
}

tests {
  const testdata = require(`./testdata/klient-delegation/${bru.getEnvVar("tokenEnv")}.js`);
  const enduser = require(`./testdata/enduser/${bru.getEnvVar("tokenEnv")}.js`);

  test("Delegate single resource to agent in v2", function() {
    const body = res.getBody();

    expect(res.status).to.equal(200);
    expect(body).to.be.an("array");
    expect(body.length).to.be.greaterThan(0);

    const item = body[0];

    expect(String(item.fromId).toLowerCase()).to.equal(
      enduser.org1_delegates_tilgangspakke.partyuuid.toLowerCase()
    );
    expect(String(item.toId).toLowerCase()).to.equal(
      testdata.REGN_Organisasjon.REGN_Agent.userUuid.toLowerCase()
    );
    expect(String(item.viaId).toLowerCase()).to.equal(
      enduser.org2_delegates_tilgangspakke.partyuuid.toLowerCase()
    );
    expect(item.changed).to.equal(true);

    // The response identifies the resource by internal guid, not by the RefId that
    // was sent in. Keep it for the follow-up requests so the flow can correlate.
    expect(item).to.have.property("resourceId");
    bru.setVar("delegatedResourceId", item.resourceId);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
