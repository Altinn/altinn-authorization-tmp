meta {
  name: GET_v2_Agent_Resources
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/clientdelegations/agents/resources?party={{party}}&agent={{agent}}
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  agent: {{agent}}
}

script:pre-request {
  const sharedtestdata = require(`./testdata/sharedtestdata.js`);
  const testdata = require(`./testdata/klient-delegation/${bru.getEnvVar("tokenEnv")}.js`);
  const enduser = require(`./testdata/enduser/${bru.getEnvVar("tokenEnv")}.js`);

  bru.setVar("party", enduser.org2_delegates_tilgangspakke.partyuuid);
  bru.setVar("agent", testdata.REGN_Organisasjon.REGN_Agent.userUuid);

  var getTokenParameters = {
    auth_userId: enduser.org2_delegates_tilgangspakke.innehaver.userid,
    auth_partyId: enduser.org2_delegates_tilgangspakke.innehaver.partyid,
    auth_partyUuid: enduser.org2_delegates_tilgangspakke.innehaver.partyuuid,
    auth_ssn: enduser.org2_delegates_tilgangspakke.innehaver.pid,
    auth_tokenType: sharedtestdata.authTokenType.personal,
    auth_scopes: sharedtestdata.auth_scopes.portalEnduser
  }

  const testTokenGenerator = require(`./TestToolsTokenGenerator.js`);
  const token = await testTokenGenerator.getToken(getTokenParameters);
  bru.setVar("bearerToken",  token);
}

tests {
  const testdata = require(`./testdata/klient-delegation/${bru.getEnvVar("tokenEnv")}.js`);
  const enduser = require(`./testdata/enduser/${bru.getEnvVar("tokenEnv")}.js`);

  test("Delegated resources to agent are grouped by client", function() {
    const body = res.getBody();

    expect(res.status).to.equal(200);
    expect(body).to.have.property("data");

    const clientUuid = enduser.org1_delegates_tilgangspakke.partyuuid.toLowerCase();
    const entry = body.data.find(item =>
      String(item.client.id || "").toLowerCase() === clientUuid
    );

    expect(entry, "Client not found in delegated resources").to.exist;

    // The listing carries no agentAddedAt, unlike the accesspackages listing.
    expect(entry).to.not.have.property("agentAddedAt");

    const resources = entry.access.flatMap(a => a.resources || []);
    expect(resources.length).to.be.greaterThan(0);

    // Resources come back as { id, refId }, so the listing can be matched on the
    // same resource registry id the delegation was sent with.
    const resourceRefId = testdata.resources.clientDelgResourceId;
    const delegated = resources.find(r => r.refId === resourceRefId);

    expect(delegated, "Delegated resource not found by refId").to.exist;
    expect(String(delegated.id).toLowerCase()).to.equal(
      String(bru.getVar("delegatedResourceId") || "").toLowerCase()
    );
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
